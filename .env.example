# Configuración de conexiones del Optimizador y Organizador de Proyectos (Forja / Project Forge)
# Copiá este archivo a .env (que está excluido de git) o configurá las variables en tu entorno de usuario de Windows.
# Ninguna clave es compartida entre proveedores: cada integración usa su propia credencial.

# 1. TypeSafe (Jev - System One API) - https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# 2. Modelo Generativo (para síntesis de briefs, redacción de especificaciones e investigación asistida)
# Soporta OpenAI compatible (OPENAI_API_KEY) o Gemini (GEMINI_API_KEY)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# 3. GitHub (para consultas de mayor cuota en API de repositorios/commits y preparación de ramas/PRs)
GITHUB_TOKEN=

# 4. X / Twitter API v2 (opcional, para búsqueda directa en /2/tweets/search/recent)
# Si no se configura, el adaptador de X degrada de forma explícita a búsqueda pública indexada o pendiente.
X_BEARER_TOKEN=

# 5. Puerto del servidor local
PORT=3847
